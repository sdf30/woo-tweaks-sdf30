<?xml version="1.0"?>
<ruleset name="WordPress Tweaks Coding Standards">
    <description>Custom ruleset for the WooCommerce Tweaks plugin.</description>

    <!-- Exclude vendor directory -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/temp_/*</exclude-pattern>

    <!-- Use WordPress-Core standard -->
    <rule ref="WordPress-Core" />

    <!-- Additional WordPress standards (optional but recommended) -->
    <rule ref="WordPress-Docs" />
    <rule ref="WordPress-Extra" />

    <!-- Set the minimum supported WP version -->
    <config name="minimum_supported_wp_version" value="6.0" />

    <!-- Allow for plugin specific text-domain -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array" value="tweak-tools-sdf30" />
        </properties>
    </rule>

    <!-- Check all files in the current directory and subdirectories -->
    <file>.</file>

    <!-- Show colors in console -->
    <arg name="colors" />
    <!-- Show sniff codes -->
    <arg value="s" />
</ruleset>
