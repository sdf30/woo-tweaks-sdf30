    "apiVersion": 3,
    "name": "woo-tweaks-tools/read-more-button",
    "version": "1.0.0",
    "title": "Woo Tweaks: Read More Button",
    "category": "widgets",
    "textdomain": "woo-tweaks-tools",
    "icon": "external",
